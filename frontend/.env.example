# Base URL for FastAPI (admin auth, quiz demo, admin quiz API). See lib/backend-url.ts
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Only needed with pnpm dev when frontend and backend are on different hostnames
# (e.g. two cloudflared tunnels). Set to the frontend's public URL.
# NEXT_PUBLIC_ALLOWED_DEV_ORIGIN=https://your-frontend.trycloudflare.com

# Public path prefix for quiz media assets (must match backend MEDIA_PUBLIC_PREFIX).
# NEXT_PUBLIC_MEDIA_PUBLIC_PREFIX=/media/quiz-assets
