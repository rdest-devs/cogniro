# Copy to .env and fill in real values. Never commit .env.

# --- Admin auth (POST /admin/auth/login) ---
# Generate a bcrypt hash locally, then paste only the hash here:
#   uv run python scripts/hash_admin_password.py
# Keep the value single-quoted so shells/docker-compose do not expand the '$' segments.
ADMIN_PASSWORD_HASH='$2b$12$replace-with-your-real-bcrypt-hash................'

# Required for JWT signing in production (tests set a default in conftest).
JWT_SECRET=your-very-long-random-secret-value-at-least-32-bytes
# Keep short because logout revocation is in-memory for this single-server app (max: 60).
JWT_EXPIRE_MINUTES=15
# Refresh token lifetime in days for silent access-token renewal (max: 30).
ADMIN_REFRESH_EXPIRE_DAYS=7
# HTTPS production: set to true so the refresh cookie is not sent over plain HTTP.
# Local dev over http://localhost typically keeps this false.
ADMIN_REFRESH_COOKIE_SECURE=true
# lax (default) | strict | none — use none when the admin UI is on a different site than
# the API (e.g. app.example.com calling api.example.com). none forces Secure=true.
# ADMIN_REFRESH_COOKIE_SAMESITE=none

# --- Quiz / existing flags ---
QUIZ_SHOW_ANSWER_REVIEW=true

# --- Results retention (background purge in FastAPI lifespan) ---
RESULT_RETENTION_DAYS=30
PURGE_INTERVAL_SECONDS=3600

# --- Admin quiz ZIP import (POST /admin/quiz/import) ---
# Max multipart upload size for the .zip file (default 100 MiB).
# MAX_QUIZ_IMPORT_ZIP_BYTES=104857600
# Max uncompressed bytes for quiz.kqf inside the zip (default 2 MiB).
# MAX_QUIZ_IMPORT_KQF_BYTES=2097152
# Max uncompressed bytes per media/* member (default 100 MiB).
# MAX_QUIZ_IMPORT_MEMBER_BYTES=104857600
# Max total uncompressed bytes extracted per import (default 300 MiB).
# MAX_QUIZ_IMPORT_UNCOMPRESSED_TOTAL_BYTES=314572800

# --- Filesystem (quizzes, results, editor upload staging) ---
# Optional root: must contain subdirs storage/ (quizzes, results) and uploads/quiz-assets/.
# When unset, default is the backend package directory (…/backend), i.e. ./storage/ and ./uploads/ next to this code.
# COGNIRO_DATA_DIR=/var/lib/cogniro
#
# Optional: path to the storage directory only (contains quizzes/ and results/ after startup).
# Parent of this path is used for uploads/quiz-assets/. When set, COGNIRO_DATA_DIR is ignored for quiz/result paths.
# COGNIRO_STORAGE_DIR=/var/lib/cogniro/storage

# --- CORS (comma-separated); omit to use dev defaults (localhost:3000 + 127.0.0.1:3000) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Live sessions / participant join URL (admin activate → join_url) ---
# Origin of the Next.js app (used to build /play/?code=PIN links). No trailing slash.
FRONTEND_ORIGIN=http://localhost:3000
# Optional: override absolute URLs for quiz media on POST /play/{pin}/join when the API
# is reached via localhost but clients must load /media/{quiz_id}/... from a public host.
# Public quiz media is only served while that quiz's session is active (403 otherwise).
# MEDIA_ABSOLUTE_ORIGIN=https://api.example.com

# --- POST /play/{pin}/join|submit — per-IP rate limit (sliding window) ---
# PLAY_RATE_LIMIT_ENABLED=true
# PLAY_RATE_LIMIT_WINDOW_SEC=60
# PLAY_RATE_LIMIT_MAX_REQUESTS=120
# Trust first X-Forwarded-For hop (only behind a trusted reverse proxy):
# PLAY_RATE_LIMIT_TRUST_X_FORWARDED_FOR=false

